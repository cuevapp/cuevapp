# ---- Secrets / local env ----
# Ignore real env files (they hold live keys) but KEEP the *.example templates.
.env
.env.*
!.env.example
!.env.production.example
# Web env: ignore local dev env, keep the committed templates.
web/.env
web/.env.*
!web/.env.example
!web/.env.production

# ---- Python ----
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# ---- Node / web build ----
node_modules/
web/dist/
dist/
*.tsbuildinfo
npm-debug.log*

# ---- Backups (kept outside the repo, but never commit them) ----
cueva-bundle-backup-*.zip

# ---- Capacitor / native build artifacts (the ios/ & android/ projects ARE committed) ----
web/android/.gradle/
web/android/build/
web/android/app/build/
web/android/capacitor-cordova-android-plugins/
web/android/local.properties
web/ios/App/Pods/
web/ios/App/build/
web/ios/App/output/
web/ios/App/Podfile.lock
web/.gradle/
*.iml

# ---- Android release signing (NEVER commit the keystore or its passwords) ----
*.jks
*.keystore
web/android/keystore.properties

# ---- OS / editor cruft ----
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/
.claude/settings.local.json

# ---- Local emulator/debug artifacts (not part of the project) ----
web/android/*.png
web/android/*-log.txt
