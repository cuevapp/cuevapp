# Production build for cuevapp.com — Vite auto-loads this for `npm run build`.
# VITE_* values are inlined into the bundle at build time (not secrets — the Auth0
# client id is public by design).

VITE_API_URL=https://api.cuevapp.com
VITE_USE_MOCK=false

# --- Auth0 (REQUIRED for prod login) — fill from your Auth0 dashboard ---
# SPA application Domain + Client ID, and the API Identifier as the audience.
# Until these are real, production login will not work (the backend rejects dev tokens).
VITE_AUTH0_DOMAIN=YOUR_TENANT.us.auth0.com
VITE_AUTH0_CLIENT_ID=YOUR_SPA_CLIENT_ID
VITE_AUTH0_AUDIENCE=https://api.cuevapp.com

# --- Donate ---
VITE_DONATE_URL=https://buymeacoffee.com/cuevaapp
