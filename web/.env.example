# === Default: standalone with the in-browser mock (no config needed) ===
# Leave everything unset and `npm run dev` runs fully self-contained.

# === Real backend ===
# VITE_API_URL=http://localhost:8000
# VITE_USE_MOCK=false

# === Fandango affiliate (Commission Junction) ===
# When set, "Get tickets" links on in-theater films route through CJ's tracking
# redirect so ticket sales earn commission. From your CJ dashboard after the
# Fandango program is approved. Unset = plain (untracked) Fandango search links.
# VITE_CJ_PID=               # your CJ website/publisher id
# VITE_CJ_FANDANGO_AID=      # Fandango advertiser link id in CJ
# VITE_CJ_DOMAIN=anrdoezrs.net   # optional; CJ shows the right redirect domain

# === Real identity provider (Auth0) ===
# Set these and the app switches from the mock IdP to Auth0's hosted login.
# From your Auth0 dashboard: Application (SPA) + API (the audience).
# VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
# VITE_AUTH0_CLIENT_ID=xxxxxxxxxxxxxxxxxxxx
# VITE_AUTH0_AUDIENCE=https://api.cueva.app
#
# The backend must verify the same issuer/audience — set in the backend's .env:
#   AUTH_ISSUER=https://your-tenant.us.auth0.com/
#   AUTH_AUDIENCE=https://api.cueva.app
