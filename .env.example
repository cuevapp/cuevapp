# Copy to .env and fill in. Never commit the real .env.

TMDB_API_TOKEN=your-tmdb-v4-read-access-token
ANTHROPIC_API_KEY=sk-ant-...
DATABASE_URL=postgresql://cueva:cueva@localhost:5432/cueva

# Optional overrides (defaults shown)
CUEVA_MODEL=claude-sonnet-4-6
CUEVA_MODEL_VERSION=fp-v1-sonnet46
CUEVA_REGION=US

# --- auth (from your identity provider's dashboard) ---
AUTH_ISSUER=https://your-tenant.us.auth0.com/
AUTH_AUDIENCE=https://api.cueva.app
# AUTH_JWKS_URL=        # optional; derived from issuer if blank
# AUTH_DEV_MODE=false   # DEV ONLY — accept "dev:<subject>" tokens. NEVER true in prod.

# --- CORS / rate limiting ---
API_CORS_ORIGINS=http://localhost:3000,http://localhost:8081   # set to real web/app origins in prod
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE_URI=memory://     # use redis://host:6379 in production (shared across instances)
RATE_LIMIT_PUBLIC=60/minute
RATE_LIMIT_READ=120/minute
RATE_LIMIT_WRITE=20/minute
