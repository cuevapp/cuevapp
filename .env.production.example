# Backend production environment for api.cuevapp.com.
# Do NOT commit real secrets — set these in your host's secret store (Render env vars
# marked "secret", or a secret manager). This file is just the template/reference.

# --- credentials (secrets) ---
TMDB_API_TOKEN=          # TMDB v4 read token (ROTATE the one used in dev before launch)
ANTHROPIC_API_KEY=       # Anthropic key   (ROTATE the one used in dev before launch)
DATABASE_URL=            # Neon pooled connection string, e.g. postgresql://user:pass@ep-xxx-pooler.neon.tech/cueva?sslmode=require

# --- auth (Auth0) ---
AUTH_DEV_MODE=false              # MUST be false in prod — disables the dev:<sub> token backdoor
AUTH_ISSUER=https://YOUR_TENANT.us.auth0.com/
AUTH_AUDIENCE=https://api.cuevapp.com
# AUTH_JWKS_URL=                 # optional; derived from issuer if blank

# --- scheduled refresh trigger ---
# Shared secret the cron-job.org trigger sends in the X-Cron-Token header to start a refresh.
# Generate a long random value; set the SAME value in the cron-job.org job. Empty = endpoint off.
CRON_TRIGGER_TOKEN=

# --- CORS / rate limiting ---
API_CORS_ORIGINS=https://cuevapp.com,https://www.cuevapp.com   # never "*"
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE_URI=memory://     # set redis://... once you run more than one API instance

# --- scoring ---
CUEVA_REGION=US
CUEVA_MODEL=claude-sonnet-4-6
CUEVA_MODEL_VERSION=fp-v1-sonnet46   # bump only to force a full catalog re-score
